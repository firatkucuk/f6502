// Sprite frame pointers and the high-bit masks for the VIC-II X registers.
data @addr(0x4000) {
  shipFrames: [u8; 16] = [235, 236, 237, 238, 239, 240, 241, 242, 243, 244, 245, 246, 247, 248, 249, 250];
  rockFrames: [u8; 4] = [251, 252, 253, 254];
  // Magnitudes of clockwise direction vectors; signs are selected by quadrant.
  directionX: [u8; 16] = [0, 3, 6, 7, 8, 7, 6, 3, 0, 3, 6, 7, 8, 7, 6, 3];
  directionY: [u8; 16] = [8, 7, 6, 3, 0, 3, 6, 7, 8, 7, 6, 3, 0, 3, 6, 7];
  shotX: [u8; 16] = [0, 15, 28, 37, 40, 37, 28, 15, 0, 15, 28, 37, 40, 37, 28, 15];
  shotY: [u8; 16] = [40, 37, 28, 15, 0, 15, 28, 37, 40, 37, 28, 15, 0, 15, 28, 37];
  xHighMask: [u8; 6] = [1, 2, 4, 8, 16, 32];
  xLowMask: [u8; 6] = [254, 253, 251, 247, 239, 223];
  starCols: [u8; 18] = [14, 7, 32, 27, 29, 26, 29, 20, 12, 23, 17, 20, 6, 9, 11, 35, 34, 4];
  starRows: [u8; 18] = [8, 9, 5, 13, 18, 9, 3, 5, 16, 7, 12, 13, 12, 14, 3, 9, 3, 8];
}

let @zp mode: u8 = 0;          // 0 title, 1 playing, 2 ship hit, 3 lost beyond the field
let @zp introTimer: u16 = 60;
let @zp fireArmed: u8 = 0;
let @zp heading: u8 = 0;       // 0 up, then clockwise in 22.5-degree steps
let @zp thrustTick: u8 = 0;
let @zp turnDelay: u8 = 0;      // held turns repeat every 8 frames
let @zp shipX: u16 = 160;
let @zp shipY: u8 = 130;
// Velocity uses 1/128 pixel per frame, biased by 32768 to represent either sign.
// Fraction accumulators preserve small impulses. No drag or automatic braking is applied.
let @zp shipVX: u16 = 32768;
let @zp shipVY: u16 = 32768;
let @zp shipFracX: u16 = 32768;
let @zp shipFracY: u16 = 32768;
let @zp bulletOn: u8 = 0;
let @zp bulletVX: u16 = 32768;
let @zp bulletVY: u16 = 32768;
let @zp bulletFracX: u16 = 32768;
let @zp bulletFracY: u16 = 32768;
let @zp bulletX: u16 = 0;
let @zp bulletY: u8 = 0;
let @zp r0x: u16 = 36;
let @zp r0y: u8 = 120;
let @zp rockIndex: u8 = 0;
let @zp rockDirection: u8 = 0;
let @zp rockTick: u8 = 0;
let @zp rockDelay: u8 = 2;
let @zp difficultyTimer: u16 = 0;
let @zp lives: u8 = 3;
let @zp respawnTimer: u8 = 0;
let @zp respawnBlinkTick: u8 = 0;
let @zp shipVisible: u8 = 1;
let @zp scoreOnes: u8 = 0;
let @zp scoreTens: u8 = 0;
let @zp scoreHundreds: u8 = 0;
let @zp explosionTimer: u8 = 0;
let @zp starRow: u8 = 0;
let @zp starCol: u8 = 0;
let @zp starShiftX: u8 = 0;
let @zp starShiftY: u8 = 0;
let @zp starIndex: u8 = 0;
let @zp dx: u16 = 0;
let @zp dy: u8 = 0;
let @zp targetX: u16 = 0;
let @zp targetY: u8 = 0;

fn frame(): void {
  while (VIC2.rasterLine != 200) {}
  while (VIC2.rasterLine == 200) {}
}

// The browser maps LEFT to CRSR_RIGHT + SHIFT, RIGHT to CRSR_RIGHT, and UP to CRSR_DOWN + SHIFT.
fn leftKey(): u8 {
  CIA1.portA = 0xFE;
  if ((CIA1.portB & 0x04) == 0) {
    CIA1.portA = 0xFD;
    if ((CIA1.portB & 0x80) == 0) { return 1; }
  }
  return 0;
}

fn rightKey(): u8 {
  CIA1.portA = 0xFE;
  if ((CIA1.portB & 0x04) == 0) {
    CIA1.portA = 0xFD;
    if ((CIA1.portB & 0x80) != 0) { return 1; }
  }
  return 0;
}

fn thrustKey(): u8 {
  CIA1.portA = 0xFE;
  if ((CIA1.portB & 0x80) == 0) {
    CIA1.portA = 0xFD;
    if ((CIA1.portB & 0x80) == 0) { return 1; }
  }
  return 0;
}

fn fireKey(): u8 {
  CIA1.portA = 0x7F;
  if ((CIA1.portB & 0x10) == 0) { return 1; }
  return 0;
}

fn setSpriteX(slot: u8, xLow: u8, xHigh: u8): void {
  let reg: u16 = 0xD000 + slot + slot;
  poke(reg, xLow);
  if (xHigh != 0) {
    VIC2.spriteXmsb = VIC2.spriteXmsb | xHighMask[slot];
  } else {
    VIC2.spriteXmsb = VIC2.spriteXmsb & xLowMask[slot];
  }
}

fn setSpriteY(slot: u8, y: u8): void {
  let reg: u16 = 0xD001 + slot + slot;
  poke(reg, y);
}

fn setSpritePosition(slot: u8, xLow: u8, xHigh: u8, y: u8): void {
  setSpriteX(slot, xLow, xHigh);
  setSpriteY(slot, y);
}

fn drawStars(): void {
  clrscr();
  for (starIndex = 0; starIndex < 18; starIndex++) {
    starCol = starCols[starIndex] + starShiftX;
    if (starCol >= 36) { starCol = starCol - 32; }
    starRow = starRows[starIndex] + starShiftY;
    if (starRow >= 19) { starRow = starRow - 16; }
    poke(screen(starRow, starCol), 0x2E);
    poke(color(starRow, starCol), COLOR_DARK_GREY);
  }
  starShiftX = starShiftX + 13;
  if (starShiftX >= 32) { starShiftX = starShiftX - 32; }
  starShiftY = starShiftY + 7;
  if (starShiftY >= 16) { starShiftY = starShiftY - 16; }
}

fn drawScore(): void {
  poke(screen(0, 36), scoreHundreds + 0x30);
  poke(screen(0, 37), scoreTens + 0x30);
  poke(screen(0, 38), scoreOnes + 0x30);
  poke(color(0, 36), COLOR_WHITE);
  poke(color(0, 37), COLOR_WHITE);
  poke(color(0, 38), COLOR_WHITE);
}

fn addScore(): void {
  scoreOnes = scoreOnes + 1;
  if (scoreOnes == 10) {
    scoreOnes = 0;
    scoreTens = scoreTens + 1;
    if (scoreTens == 10) {
      scoreTens = 0;
      scoreHundreds = scoreHundreds + 1;
      if (scoreHundreds == 10) { scoreHundreds = 0; }
    }
  }
  drawScore();
}

fn showSplash(): void {
  VIC2.spriteEnable = 0;
  clrscr();
  puts(5, 0, " **  **** **** **** ***   **  **** *** ", COLOR_CYAN);
  puts(6, 0, "*  * *     **  *    *  * *  *  **  *  *", COLOR_CYAN);
  puts(7, 0, "****  **   **  ***  ***  *  *  **  *  *", COLOR_CYAN);
  puts(8, 0, "*  *    *  **  *    * *  *  *  **  *  *", COLOR_CYAN);
  puts(9, 0, "*  * ****  **  **** *  *  **  **** *** ", COLOR_CYAN);
  puts(12, 13, "***  *  * *  *", COLOR_CYAN);
  puts(13, 13, "*  * *  * ** *", COLOR_CYAN);
  puts(14, 13, "***  *  * * **", COLOR_CYAN);
  puts(15, 13, "* *  *  * *  *", COLOR_CYAN);
  puts(16, 13, "*  *  **  *  *", COLOR_CYAN);
}

// The prompt appears under the wordmark once the splash has been on screen for a moment.
fn showPrompt(): void {
  puts(20, 14, "PRESS SPACE", COLOR_WHITE);
}

fn drawLives(): void {
  if (lives == 3) {
    puts(0, 1, "***", COLOR_WHITE);
  } else if (lives == 2) {
    puts(0, 1, "** ", COLOR_WHITE);
  } else if (lives == 1) {
    puts(0, 1, "*  ", COLOR_WHITE);
  } else {
    puts(0, 1, "   ", COLOR_WHITE);
  }
}

fn drawHud(): void {
  drawLives();
  drawScore();
}

fn startGame(): void {
  mode = 1;
  heading = 0;
  turnDelay = 0;
  shipX = 160;
  shipY = 130;
  shipVX = 32768;
  shipVY = 32768;
  shipFracX = 32768;
  shipFracY = 32768;
  thrustTick = 0;
  bulletOn = 0;
  scoreOnes = 0;
  scoreTens = 0;
  scoreHundreds = 0;
  lives = 3;
  respawnTimer = 0;
  respawnBlinkTick = 0;
  shipVisible = 1;
  difficultyTimer = 0;
  rockDelay = 2;
  explosionTimer = 0;
  r0x = 36;
  r0y = 120;
  rockIndex = 0;
  rockDirection = 0;
  rockTick = 0;
  drawStars();
  drawHud();
  VIC2.spriteEnable = 0x03;
  poke(0xD01C, 0x3F); // ship, rocks and shot use C64 multicolour mode
  poke(SPRITE_PTRS + 0, shipFrames[heading]);
  poke(SPRITE_PTRS + 1, rockFrames[rockIndex]);
  poke(SPRITE_PTRS + 5, 255);
  VIC2.sprite0color = COLOR_CYAN;
  VIC2.sprite1color = COLOR_ORANGE;
  VIC2.sprite5color = COLOR_YELLOW;
  poke(0xD025, COLOR_RED);
  poke(0xD026, COLOR_LIGHT_GREY);
  VIC2.spriteXmsb = 0;
  setSpritePosition(0, lo(shipX), hi(shipX), shipY);
  setSpritePosition(1, lo(r0x), hi(r0x), r0y);
  setSpritePosition(5, 40, 0, 45);
}

fn loseLife(): void {
  if (lives > 0) { lives = lives - 1; }
  drawLives();
  bulletOn = 0;
  VIC2.spriteEnable = VIC2.spriteEnable & 0xDF;
  if (lives > 0) {
    mode = 1;
    heading = 0;
    turnDelay = 0;
    shipX = 160;
    shipY = 130;
    shipVX = 32768;
    shipVY = 32768;
    shipFracX = 32768;
    shipFracY = 32768;
    thrustTick = 0;
    respawnTimer = 75;
    respawnBlinkTick = 0;
    shipVisible = 1;
    poke(SPRITE_PTRS + 0, shipFrames[heading]);
    VIC2.spriteEnable = VIC2.spriteEnable | 0x01;
  }
}

fn updateRespawn(): void {
  if (respawnTimer == 0) { return; }
  respawnTimer = respawnTimer - 1;
  respawnBlinkTick = respawnBlinkTick + 1;
  if (respawnBlinkTick == 6) {
    respawnBlinkTick = 0;
    if (shipVisible == 1) {
      VIC2.spriteEnable = VIC2.spriteEnable & 0xFE;
      shipVisible = 0;
    } else {
      VIC2.spriteEnable = VIC2.spriteEnable | 0x01;
      shipVisible = 1;
    }
  }
  if (respawnTimer == 0) {
    VIC2.spriteEnable = VIC2.spriteEnable | 0x01;
    shipVisible = 1;
  }
}

fn updateDifficulty(): void {
  difficultyTimer = difficultyTimer + 1;
  if (difficultyTimer == 1000) {
    difficultyTimer = 0;
    if (rockDelay > 0) { rockDelay = rockDelay - 1; }
  }
}

fn turnAndThrust(): void {
  let impulse: u8 = 0;
  updateRespawn();
  if (turnDelay > 0) { turnDelay = turnDelay - 1; }
  if (leftKey() == 1) {
    if (turnDelay == 0) {
      if (heading == 0) { heading = 15; } else { heading = heading - 1; }
      turnDelay = 8;
    }
  } else if (rightKey() == 1) {
    if (turnDelay == 0) {
      heading = heading + 1;
      if (heading == 16) { heading = 0; }
      turnDelay = 8;
    }
  } else {
    turnDelay = 0;
  }
  poke(SPRITE_PTRS + 0, shipFrames[heading]);

  // A gentle impulse every fourth held-thrust frame. Turning alone preserves velocity.
  if (thrustTick > 0) { thrustTick = thrustTick - 1; }
  if (thrustKey() == 1 && thrustTick == 0) {
    thrustTick = 4;
    impulse = directionX[heading];
    if (heading < 8) { shipVX = shipVX + impulse; }
    else { shipVX = shipVX - impulse; }
    impulse = directionY[heading];
    if (heading < 4) { shipVY = shipVY - impulse; }
    else if (heading < 12) { shipVY = shipVY + impulse; }
    else { shipVY = shipVY - impulse; }
  }

  // Integrate velocity every frame, including all frames with no keys held.
  shipFracX = shipFracX + shipVX;
  shipFracX = shipFracX - 32768;
  shipFracY = shipFracY + shipVY;
  shipFracY = shipFracY - 32768;
  while (shipFracX >= 32896) { shipFracX = shipFracX - 128; shipX = shipX + 1; }
  while (shipFracX < 32768) { shipFracX = shipFracX + 128; shipX = shipX - 1; }
  while (shipFracY >= 32896) { shipFracY = shipFracY - 128; shipY = shipY + 1; }
  while (shipFracY < 32768) { shipFracY = shipFracY + 128; shipY = shipY - 1; }

  if (shipX < 24) { mode = 3; }
  if (shipX > 320) { mode = 3; }
  if (shipY < 50) { mode = 3; }
  if (shipY > 229) { mode = 3; }
  if (mode == 3) { loseLife(); }
}

fn moveRocks(): void {
  let path: u8 = rockDirection;
  let ended: u8 = 0;
  if (explosionTimer > 0) {
    explosionTimer = explosionTimer - 1;
    if (explosionTimer == 5) { VIC2.sprite1color = COLOR_YELLOW; VIC2.spriteEnable = VIC2.spriteEnable & 0xFD; }
    if (explosionTimer == 4) { VIC2.sprite1color = COLOR_WHITE; VIC2.spriteEnable = VIC2.spriteEnable | 0x02; }
    if (explosionTimer == 3) { VIC2.sprite1color = COLOR_LIGHT_RED; VIC2.spriteEnable = VIC2.spriteEnable & 0xFD; }
    if (explosionTimer == 2) { VIC2.sprite1color = COLOR_YELLOW; VIC2.spriteEnable = VIC2.spriteEnable | 0x02; }
    if (explosionTimer == 1) { VIC2.sprite1color = COLOR_WHITE; VIC2.spriteEnable = VIC2.spriteEnable & 0xFD; }
    if (explosionTimer == 0) {
      resetRock0();
      VIC2.sprite1color = COLOR_ORANGE;
      VIC2.spriteEnable = VIC2.spriteEnable | 0x02;
    }
    return;
  }
  if (rockTick == 0) {
    if (path == 0) { r0x = r0x + 1; if (r0x > 290) { ended = 1; } }
    if (path == 1) { r0x = r0x + 1; r0y = r0y + 1; if (r0x > 290) { ended = 1; } if (r0y > 218) { ended = 1; } }
    if (path == 2) { r0y = r0y + 1; if (r0y > 218) { ended = 1; } }
    if (path == 3) { r0x = r0x - 1; r0y = r0y + 1; if (r0x < 36) { ended = 1; } if (r0y > 218) { ended = 1; } }
    if (path == 4) { r0x = r0x - 1; if (r0x < 36) { ended = 1; } }
    if (path == 5) { r0x = r0x - 1; r0y = r0y - 1; if (r0x < 36) { ended = 1; } if (r0y < 54) { ended = 1; } }
    if (path == 6) { r0y = r0y - 1; if (r0y < 54) { ended = 1; } }
    if (path == 7) { r0x = r0x + 1; r0y = r0y - 1; if (r0x > 290) { ended = 1; } if (r0y < 54) { ended = 1; } }
    rockTick = rockDelay;
  } else {
    rockTick = rockTick - 1;
  }
  if (ended == 1) { resetRock0(); }
  setSpritePosition(1, lo(r0x), hi(r0x), r0y);
}

fn launchBullet(): void {
  let impulse: u16 = 0;
  let offset: u8 = 0;
  if (bulletOn == 0 && fireKey() == 1) {
    bulletOn = 1;
    // Sprite centers coincide; offset the shot toward the nose in the same heading.
    bulletX = shipX;
    bulletY = shipY;
    offset = directionX[heading];
    if (heading < 8) { bulletX = bulletX + offset; }
    else { bulletX = bulletX - offset; }
    if (heading < 4) { bulletY = bulletY - directionY[heading]; }
    else if (heading < 12) { bulletY = bulletY + directionY[heading]; }
    else { bulletY = bulletY - directionY[heading]; }
    bulletFracX = shipFracX;
    bulletFracY = shipFracY;
    // Shots inherit ship velocity, plus five pixels/frame along the nose.
    impulse = shotX[heading];
    impulse = impulse + impulse;
    impulse = impulse + impulse;
    impulse = impulse + impulse;
    impulse = impulse + impulse;
    if (heading < 8) { bulletVX = shipVX + impulse; }
    else { bulletVX = shipVX - impulse; }
    impulse = shotY[heading];
    impulse = impulse + impulse;
    impulse = impulse + impulse;
    impulse = impulse + impulse;
    impulse = impulse + impulse;
    if (heading < 4) { bulletVY = shipVY - impulse; }
    else if (heading < 12) { bulletVY = shipVY + impulse; }
    else { bulletVY = shipVY - impulse; }
    VIC2.spriteEnable = VIC2.spriteEnable | 0x20;
    poke(SPRITE_PTRS + 5, 255);
    setSpritePosition(5, lo(bulletX), hi(bulletX), bulletY);
  }
}

fn moveBullet(): void {
  if (bulletOn == 0) { return; }
  bulletFracX = bulletFracX + bulletVX;
  bulletFracX = bulletFracX - 32768;
  bulletFracY = bulletFracY + bulletVY;
  bulletFracY = bulletFracY - 32768;
  while (bulletFracX >= 32896) { bulletFracX = bulletFracX - 128; bulletX = bulletX + 1; }
  while (bulletFracX < 32768) { bulletFracX = bulletFracX + 128; bulletX = bulletX - 1; }
  while (bulletFracY >= 32896) { bulletFracY = bulletFracY - 128; bulletY = bulletY + 1; }
  while (bulletFracY < 32768) { bulletFracY = bulletFracY + 128; bulletY = bulletY - 1; }
  if (bulletX < 30) { bulletOn = 0; }
  if (bulletX > 292) { bulletOn = 0; }
  if (bulletY < 52) { bulletOn = 0; }
  if (bulletY > 224) { bulletOn = 0; }
  if (bulletOn == 1) { setSpritePosition(5, lo(bulletX), hi(bulletX), bulletY); }
  else { VIC2.spriteEnable = VIC2.spriteEnable & 0xDF; }
}

fn closeToShip(): u8 {
  if (targetX > shipX) { dx = targetX - shipX; } else { dx = shipX - targetX; }
  if (targetY > shipY) { dy = targetY - shipY; } else { dy = shipY - targetY; }
  if (dx < 22) {
    if (dy < 17) { return 1; }
  }
  return 0;
}

fn closeToBullet(): u8 {
  if (targetX > bulletX) { dx = targetX - bulletX; } else { dx = bulletX - targetX; }
  if (targetY > bulletY) { dy = targetY - bulletY; } else { dy = bulletY - targetY; }
  if (dx < 18) {
    if (dy < 15) { return 1; }
  }
  return 0;
}

fn checkShipHits(): void {
  if (explosionTimer > 0) { return; }
  if (respawnTimer > 0) { return; }
  targetX = r0x; targetY = r0y;
  if (closeToShip() == 1) {
    mode = 2;
    loseLife();
  }
}

fn resetRock0(): void {
  rockIndex = rockIndex + 1;
  if (rockIndex == 4) { rockIndex = 0; }
  rockDirection = rockDirection + 1;
  if (rockDirection == 8) { rockDirection = 0; }
  poke(SPRITE_PTRS + 1, rockFrames[rockIndex]);
  if (rockDirection == 0) { r0x = 36; r0y = 120; }
  if (rockDirection == 1) { r0x = 36; r0y = 54; }
  if (rockDirection == 2) { r0x = 160; r0y = 54; }
  if (rockDirection == 3) { r0x = 290; r0y = 54; }
  if (rockDirection == 4) { r0x = 290; r0y = 120; }
  if (rockDirection == 5) { r0x = 290; r0y = 218; }
  if (rockDirection == 6) { r0x = 160; r0y = 218; }
  if (rockDirection == 7) { r0x = 36; r0y = 218; }
}

fn checkBulletHits(): void {
  if (bulletOn == 0) { return; }
  if (explosionTimer > 0) { return; }
  targetX = r0x; targetY = r0y;
  if (closeToBullet() == 1) {
    explosionTimer = 6;
    VIC2.sprite1color = COLOR_LIGHT_RED;
    VIC2.spriteEnable = VIC2.spriteEnable | 0x02;
    addScore();
    bulletOn = 0;
  }
  if (bulletOn == 0) { VIC2.spriteEnable = VIC2.spriteEnable & 0xDF; }
}

fn showEnd(): void {
  VIC2.spriteEnable = 0;
  if (mode == 2) {
    puts(9, 13, "SHIP DESTROYED", COLOR_LIGHT_RED);
  } else {
    puts(9, 13, "LOST IN SPACE", COLOR_LIGHT_RED);
  }
  puts(12, 15, "GAME OVER", COLOR_WHITE);
  puts(14, 15, "SCORE 000", COLOR_LIGHT_GREY);
  poke(screen(14, 21), scoreHundreds + 0x30);
  poke(screen(14, 22), scoreTens + 0x30);
  poke(screen(14, 23), scoreOnes + 0x30);
  puts(18, 14, "PRESS SPACE", COLOR_YELLOW);
}

program @ 0x0810 {
  VIC2.ctrl1 = 0x1B;
  VIC2.memPointers = 0x15;
  CIA1.ddrA = 0xFF;
  CIA1.ddrB = 0x00;
  VIC2.borderColor = COLOR_BLUE;
  VIC2.bgColor0 = COLOR_BLACK;
  poke(0xD025, COLOR_RED);
  poke(0xD026, COLOR_LIGHT_GREY);
  showSplash();

  loop {
    if (mode == 0) {
      if (introTimer > 0) {
        introTimer = introTimer - 1;
        if (introTimer == 0) { showPrompt(); }
      } else {
        if (fireKey() == 0) { fireArmed = 1; }
        else if (fireArmed == 1) { fireArmed = 0; startGame(); }
      }
      frame();
    } else if (mode == 1) {
      frame();
      turnAndThrust();
      if (mode == 1) {
        updateDifficulty();
        launchBullet();
        moveBullet();
        moveRocks();
        checkBulletHits();
        checkShipHits();
        if (mode == 1) { setSpritePosition(0, lo(shipX), hi(shipX), shipY); }
      }
      if (mode != 1) { showEnd(); }
    } else {
      if (fireKey() == 1) { startGame(); }
      frame();
    }
  }
}
