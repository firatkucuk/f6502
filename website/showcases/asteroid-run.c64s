// ASTEROID RUN — steer with the arrow keys, thrust with UP, and fire with SPACE.
// Keep the ship inside the field. One rock crosses the field at a time; hitting it brings the next.

const SPRITE_DATA: u16 = 0x3AC0; // 21 aligned 64-byte sprite frames, ending at VIC bank 0.

// Each sprite is a 12 x 21 multicolour bitmap (each horizontal pixel is doubled by the VIC-II).
// The ship has sixteen headings; the rocks use dark, body and highlight pixel clusters.
