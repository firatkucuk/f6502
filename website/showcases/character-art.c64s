// Character Mode Art: a sunset painted with one solid-block character and colour RAM.
// The screen is 40 x 25 cells; every row gets one colour from the BANDS table.
const BANDS: u16 = 0x0C00;

data @addr(BANDS) {
  rows: [u8; 25] = [
    COLOR_BLUE, COLOR_BLUE, COLOR_BLUE,
    COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE,
    COLOR_RED, COLOR_RED, COLOR_RED,
    COLOR_LIGHT_RED, COLOR_LIGHT_RED,
    COLOR_ORANGE, COLOR_ORANGE,
    COLOR_YELLOW, COLOR_YELLOW,
    // the sea mirrors the sky, darker
    COLOR_ORANGE, COLOR_ORANGE,
    COLOR_RED, COLOR_RED,
    COLOR_PURPLE, COLOR_PURPLE,
    COLOR_BLUE, COLOR_BLUE,
    COLOR_DARK_GREY, COLOR_BLACK,
  ];
}

let @zp cell: u16;   // pointer into colour RAM

program @ 0x0810 {
  VIC2.borderColor = COLOR_BLACK;
  VIC2.bgColor0 = COLOR_BLACK;

  asm {
    // 1. a solid block ($A0) in every cell of screen RAM
    lda #$A0
    ldx #0
  fill:
    sta ${SCREEN_RAM},x
    sta ${SCREEN_RAM + 0x100},x
    sta ${SCREEN_RAM + 0x200},x
    sta ${SCREEN_RAM + 0x2E8},x
    inx
    bne fill

    // 2. colour each row: 40 cells through a pointer that moves down one row at a time
    lda #lo(${COLOR_RAM})
    sta ${cell}
    lda #hi(${COLOR_RAM})
    sta ${cell} + 1
    ldx #0
  row:
    lda ${BANDS},x
    ldy #39
  paint:
    sta (${cell}),y
    dey
    bpl paint
    clc
    lda ${cell}
    adc #40
    sta ${cell}
    bcc same
    inc ${cell} + 1
  same:
    inx
    cpx #25
    bne row
  }

  puts(1, 14, "C64SCRIPT", COLOR_WHITE);
  loop {}
}
