// Sprite Dance: eight sprites share one round shape and chase each other along a looping path.
// The path comes from a 128-entry sine table; indexing a table needs assembly (lda table,x).
const SHAPE: u16 = 0x0D40;   // sprite data, 64-byte aligned
const SINE: u16 = 0x0E00;    // y = 140 + 80 * sin(2 * pi * k / 128)

data @addr(SHAPE) {
  ball: [u8; 63] = [
    0x00, 0xFF, 0x00,
    0x03, 0xFF, 0xC0,
    0x07, 0xFF, 0xE0,
    0x1F, 0xFF, 0xF8,
    0x1F, 0xFF, 0xF8,
    0x3F, 0xFF, 0xFC,
    0x7F, 0xFF, 0xFE,
    0x7F, 0xFF, 0xFE,
    0x7F, 0xFF, 0xFE,
    0x7F, 0xFF, 0xFE,
    0xFF, 0xFF, 0xFF,
    0x7F, 0xFF, 0xFE,
    0x7F, 0xFF, 0xFE,
    0x7F, 0xFF, 0xFE,
    0x7F, 0xFF, 0xFE,
    0x3F, 0xFF, 0xFC,
    0x1F, 0xFF, 0xF8,
    0x1F, 0xFF, 0xF8,
    0x07, 0xFF, 0xE0,
    0x03, 0xFF, 0xC0,
    0x00, 0xFF, 0x00,
  ];
}

data @addr(SINE) {
  wave: [u8; 128] = [
    140, 144, 148, 152, 156, 159, 163, 167,
    171, 174, 178, 181, 184, 188, 191, 194,
    197, 199, 202, 204, 207, 209, 211, 212,
    214, 215, 217, 218, 218, 219, 220, 220,
    220, 220, 220, 219, 218, 218, 217, 215,
    214, 212, 211, 209, 207, 204, 202, 199,
    197, 194, 191, 188, 184, 181, 178, 174,
    171, 167, 163, 159, 156, 152, 148, 144,
    140, 136, 132, 128, 124, 121, 117, 113,
    109, 106, 102, 99, 96, 92, 89, 86,
    83, 81, 78, 76, 73, 71, 69, 68,
    66, 65, 63, 62, 62, 61, 60, 60,
    60, 60, 60, 61, 62, 62, 63, 65,
    66, 68, 69, 71, 73, 76, 78, 81,
    83, 86, 89, 92, 96, 99, 102, 106,
    109, 113, 117, 121, 124, 128, 132, 136,
  ];
}

let @zp phase: u8 = 0;   // where the leader is on the path
let @zp n: u8 = 0;       // sprite being placed
let @zp reg: u8 = 0;     // 2 * n: offset of its x/y registers

program @ 0x0810 {
  VIC2.borderColor = COLOR_BLACK;
  VIC2.bgColor0 = COLOR_BLACK;
  clrscr();
  puts(1, 14, "SPRITE DANCE", COLOR_WHITE);

  // all eight sprites read their shape from SHAPE
  poke(SPRITE_PTRS + 0, spritePtr(SHAPE));
  poke(SPRITE_PTRS + 1, spritePtr(SHAPE));
  poke(SPRITE_PTRS + 2, spritePtr(SHAPE));
  poke(SPRITE_PTRS + 3, spritePtr(SHAPE));
  poke(SPRITE_PTRS + 4, spritePtr(SHAPE));
  poke(SPRITE_PTRS + 5, spritePtr(SHAPE));
  poke(SPRITE_PTRS + 6, spritePtr(SHAPE));
  poke(SPRITE_PTRS + 7, spritePtr(SHAPE));

  VIC2.sprite0color = COLOR_RED;
  VIC2.sprite1color = COLOR_ORANGE;
  VIC2.sprite2color = COLOR_YELLOW;
  VIC2.sprite3color = COLOR_GREEN;
  VIC2.sprite4color = COLOR_CYAN;
  VIC2.sprite5color = COLOR_LIGHT_BLUE;
  VIC2.sprite6color = COLOR_PURPLE;
  VIC2.sprite7color = COLOR_LIGHT_RED;
  VIC2.spriteEnable = 0xFF;

  loop {
    // wait for one video frame
    while (VIC2.rasterLine != 200) {}
    while (VIC2.rasterLine == 200) {}

    phase = (phase + 1) & 127;

    n = 7;
    asm {
    next:
      lda ${n}
      asl a
      sta ${reg}            // 2n: this sprite's x register is $D000 + 2n, y is +1
      lda ${n}
      asl a
      asl a
      asl a
      asl a                  // n * 16: the sprites are spread 16 steps apart
      clc
      adc ${phase}
      and #127
      tax
      ldy ${reg}
      lda ${SINE},x         // x follows the sine
      sta $D000,y
      txa
      asl a                  // twice as fast ...
      clc
      adc #32                // ... and a quarter turn ahead: a figure of eight
      and #127
      tax
      lda ${SINE},x
      sta $D001,y
      dec ${n}
      bpl next
    }
  }
}
