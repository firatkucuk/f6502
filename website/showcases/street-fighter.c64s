  charBase: [u8; 4] = [0, 8, 16, 24];
  jumpTab: [u8; 28] = [0, 6, 11, 16, 20, 24, 27, 30, 32, 34, 35, 36, 36, 36, 36, 35, 34, 32, 30, 27, 24, 20, 16, 11, 6, 0, 0, 0];
