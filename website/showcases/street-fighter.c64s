  nameIdx: [u8; 4] = [0, 6, 12, 18];
  specIdx: [u8; 4] = [24, 36, 48, 60];
}

// Per-round fighter state, two bytes each (index 0 = P1, 1 = P2). Cleared as one block every round.
let @addr(0xC000) fx: [u8; 2];
let @addr(0xC002) fh: [u8; 2];
let @addr(0xC004) fst: [u8; 2];
let @addr(0xC006) ftm: [u8; 2];
let @addr(0xC008) fhp: [u8; 2];
let @addr(0xC00A) fface: [u8; 2];
let @addr(0xC00C) ffr: [u8; 2];
let @addr(0xC00E) fjt: [u8; 2];
let @addr(0xC010) fjd: [u8; 2];
let @addr(0xC012) fhit: [u8; 2];
let @addr(0xC014) fqc: [u8; 2];
let @addr(0xC016) fqct: [u8; 2];
let @addr(0xC018) fanim: [u8; 2];
let @addr(0xC01E) fflash: [u8; 2];
let @addr(0xC020) fsink: [u8; 2];
let @addr(0xC022) fcool: [u8; 2];
let @addr(0xC024) fdmg: [u8; 2];
let @addr(0xC026) fblk: [u8; 2];
let @addr(0xC028) pjOn: [u8; 2];
let @addr(0xC02A) pjX: [u8; 2];
let @addr(0xC02C) pjDir: [u8; 2];
let @addr(0xC02E) inm: [u8; 2];
let @addr(0xC030) prev: [u8; 2];
let @addr(0xC032) aiHold: [u8; 2];
// Match state that survives between rounds.
let @addr(0xC100) fchr: [u8; 2];
let @addr(0xC102) fwins: [u8; 2];
let @addr(0xC104) fmeter: [u8; 2];
let @addr(0xC106) fcolor: [u8; 2];

let tick: u8 = 0;
let rnd: u8 = 91;
let rnd2: u8 = 37;
let twoP: u8 = 0;
let stage: u8 = 0;
let aiLevel: u8 = 0;
let secs: u8 = 99;
let subT: u8 = 0;
let roundNo: u8 = 1;
let roundOver: u8 = 0;
let winner: u8 = 0;
let sfxT: u8 = 0;
let shake: u8 = 0;
let freeze: u8 = 0;

fn frame(): void {
  while (VIC2.rasterLine != 250) {}
  while (VIC2.rasterLine == 250) {}
  tick = tick + 1;
  if (sfxT > 0) {
    sfxT = sfxT - 1;
    if (sfxT == 0) {
      poke(0xD404, 0x80);
      poke(0xD40B, 0x20);
    }
  }
  if (shake > 0) {
    shake = shake - 1;
    VIC2.borderColor = COLOR_WHITE;
    if ((shake & 1) == 0) { VIC2.borderColor = COLOR_BLACK; }
  }
}

fn pause(n: u8): void {
  for (let k: u8 = 0; k < n; k++) { frame(); }
}

fn keyDown(col: u8, mask: u8): u8 {
  CIA1.portA = col;
  if ((CIA1.portB & mask) == 0) { return 1; }
  return 0;
}

fn rand(): u8 {
  rnd = rnd + 73;
  rnd = rnd + tick;
  rnd = rnd + VIC2.rasterLine;
  rnd2 = rnd2 + rnd;
  rnd = rnd + rnd2;
  return rnd;
}

fn plot(row: u8, col: u8, hue: u8): void {
  poke(screen(row, col), 0xA0);
  poke(color(row, col), hue);
}

fn absDiff(a: u8, b: u8): u8 {
  if (a > b) { return a - b; }
  return b - a;
}

fn sidInit(): void {
  let a: u16 = 0xD400;
  for (let n: u8 = 0; n < 25; n++) {
    poke(a, 0);
    a = a + 1;
  }
  poke(0xD418, 15);
  poke(0xD406, 0xA9);
  poke(0xD40C, 0x09);
  poke(0xD40D, 0x89);
}

// Voice 1 impact sounds. All three voices are gated off together when the timer runs out.
fn sfx(fq: u8, ctl: u8, n: u8): void {
  poke(0xD400, 0);
  poke(0xD401, fq);
  poke(0xD404, ctl);
  sfxT = n;
}

fn sfxSpecial(): void {
  poke(0xD407, 0);
  poke(0xD408, 0x30);
  poke(0xD40B, 0x21);
  sfxT = 12;
}

fn sfxKo(): void {
  sfx(0x06, 0x81, 30);
}

fn waitKeys(): void {
  let busy: u8 = 1;
  while (busy == 1) {
    busy = keyDown(0x7F, 0x10);
    if (keyDown(0xFB, 0x20) == 1) { busy = 1; }
    if (keyDown(0xEF, 0x40) == 1) { busy = 1; }
    if (keyDown(0x7F, 0x01) == 1) { busy = 1; }
    if (keyDown(0x7F, 0x08) == 1) { busy = 1; }
    frame();
  }
}

// Variable-position text is written as screen codes from a table.
fn putCodes(idx: u8, n: u8, row: u8, col: u8, hue: u8): void {
  for (let j: u8 = 0; j < n; j++) {
    let ch: u8 = textTab[idx];
    poke(screen(row, col), ch);
    poke(color(row, col), hue);
    idx = idx + 1;
    col = col + 1;
  }
}

fn showName(c: u8, row: u8, col: u8, hue: u8): void {
  let idx: u8 = nameIdx[c];
  putCodes(idx, 6, row, col, hue);
}

fn showSpecialName(c: u8, row: u8, col: u8, hue: u8): void {
  let idx: u8 = specIdx[c];
  putCodes(idx, 12, row, col, hue);
}

// ---------------------------------------------------------------- stages

fn drawStage(s: u8): void {
  let n: u8 = sBase[s];
  let row: u8 = 3;
  for (let b: u8 = 0; b < 4; b++) {
    let e: u8 = sEnd[n];
    let hue: u8 = sCol[n];
    while (row < e) {
      for (let col: u8 = 0; col < 40; col++) { plot(row, col, hue); }
      row = row + 1;
    }
    n = n + 1;
  }
  let dr: u8 = decoRow[s];
  let dc: u8 = decoCol[s];
  for (let col: u8 = 0; col < 40; col++) {
    if ((col & 3) == 0) { plot(dr, col, dc); }
  }
}

// ---------------------------------------------------------------- hud

fn drawGauge(i: u8, row: u8, v: u8, hue: u8): void {
  let th: u8 = 0;
  let col: u8 = 1;
  if (i == 1) { col = 38; }
  for (let b: u8 = 0; b < 10; b++) {
    let h: u8 = COLOR_DARK_GREY;
    if (v > th) { h = hue; }
    plot(row, col, h);
    th = th + 10;
    if (i == 0) { col = col + 1; } else { col = col - 1; }
  }
}

fn drawSide(i: u8): void {
  let v: u8 = fhp[i];
  let h: u8 = COLOR_YELLOW;
  if (v < 30) { h = COLOR_LIGHT_RED; }
  drawGauge(i, 1, v, h);
  v = fmeter[i];
  h = COLOR_CYAN;
  if (v >= 100) {
    if ((tick & 8) == 0) { h = COLOR_WHITE; }
  }
  drawGauge(i, 2, v, h);
}

fn drawTimer(): void {
  let t: u8 = 0;
  let s: u8 = secs;
  while (s >= 10) { s = s - 10; t = t + 1; }
  poke(screen(1, 19), t + 0x30);
  poke(screen(1, 20), s + 0x30);
  poke(color(1, 19), COLOR_WHITE);
  poke(color(1, 20), COLOR_WHITE);
}

fn drawHud(): void {
  let c: u8 = fchr[0];
  showName(c, 0, 1, COLOR_WHITE);
  c = fchr[1];
  showName(c, 0, 33, COLOR_WHITE);
  c = fwins[0];
  poke(screen(0, 8), c + 0x30);
  c = fwins[1];
  poke(screen(0, 31), c + 0x30);
  drawSide(0);
  drawSide(1);
  drawTimer();
}

// ---------------------------------------------------------------- sprites

fn setupSprites(): void {
  VIC2.spriteEnable = 0;
  VIC2.spriteXmsb = 0;
  VIC2.spriteYexp = 0x0F;
  poke(0xD01D, 0x0F);
  poke(0xD01C, 0x0F);
  poke(0xD01B, 0);
  poke(0xD025, 10);
  poke(0xD026, 0);
  poke(SPRITE_PTRS + 2, 255);
  poke(SPRITE_PTRS + 3, 255);
  poke(0xD029, COLOR_CYAN);
  poke(0xD02A, COLOR_CYAN);
}

fn showFighters(): void {
  let msb: u8 = 0;
  let en: u8 = 3;
  let t: u8 = 0;
  let x: u8 = 0;
  let sy: u8 = 0;
  for (let i: u8 = 0; i < 2; i++) {
    let ra: u16 = 0xD000;
    let pa: u16 = 0xD004;
    let ca: u16 = 0xD027;
    let pp: u16 = SPRITE_PTRS;
    let b1: u8 = 1;
    let b2: u8 = 4;
    if (i == 1) {
      ra = 0xD002;
      pa = 0xD006;
      ca = 0xD028;
      pp = SPRITE_PTRS + 1;
      b1 = 2;
      b2 = 8;
    }
    t = fchr[i];
    let p: u8 = charBase[t];
    t = ffr[i];
    p = p + t;
    p = p + 223;
    if (t > 1 && t < 4) {
      t = fface[i];
      if (t == 1) { p = p + 4; }
    }
    poke(pp, p);
    x = fx[i];
    t = fh[i];
    sy = 158 - t;
    t = fsink[i];
    sy = sy + t;
    t = fcolor[i];
    p = fflash[i];
    if (p > 0) { t = COLOR_WHITE; }
    poke(ca, t);
    t = x + 24;
    poke(ra, t);
    poke(ra + 1, sy);
    if (x >= 232) { msb = msb + b1; }
    p = pjOn[i];
    if (p == 1) {
      x = pjX[i];
      t = x + 24;
      poke(pa, t);
      poke(pa + 1, 166);
      en = en + b2;
      if (x >= 232) { msb = msb + b2; }
    }
  }
  VIC2.spriteXmsb = msb;
  VIC2.spriteEnable = en;
}

// ---------------------------------------------------------------- input

// Key bits: 1 up, 2 down, 4 left, 8 right, 16 punch, 32 kick.
fn scanPlayer(base: u8, who: u8): void {
  let m: u8 = 0;
  let k: u8 = base;
  for (let j: u8 = 0; j < 6; j++) {
    let c: u8 = keyCol[k];
    let mk: u8 = keyMask[k];
    CIA1.portA = c;
    if ((CIA1.portB & mk) == 0) {
      let b: u8 = bitv[j];
      m = m + b;
    }
    k = k + 1;
  }
  inm[who] = m;
}

// The computer picks a plan every few frames and holds the keys for it.
fn aiThink(): void {
  let hold: u8 = aiHold[1];
  if (hold > 0) {
    aiHold[1] = hold - 1;
    return;
  }
  let ax: u8 = fx[1];
  let px: u8 = fx[0];
  let d: u8 = absDiff(ax, px);
  let r: u8 = rand();
  let plan: u8 = 4;
  let t: u8 = fst[0];
  let threat: u8 = pjOn[0];
  if (t == 2) { threat = 1; }
  if (t == 3) { threat = 1; }
  if (t == 7) { threat = 1; }
  if (threat == 1 && d < 80) {
    plan = 5;
    t = aiBlock[aiLevel];
    if (r > t) { plan = 3; }
  }
  if (plan == 4) {
    if (d < 56) {
      plan = 1;
      if (r > 80) { plan = 2; }
      if (r > 150) { plan = 7; }
      if (r > 190) { plan = 5; }
      if (r > 225) { plan = 6; }
    } else {
      if (d > 100) {
        if (r < 40) { plan = 6; }
      }
    }
  }
  let m: u8 = planBits[plan];
  t = planDir[plan];
  let toward: u8 = 8;
  let away: u8 = 4;
  if (px < ax) { toward = 4; away = 8; }
  if (t == 1) { m = m + toward; }
  if (t == 2) { m = m + away; }
  inm[1] = m;
  hold = r & 7;
  hold = hold + 5;
  if (aiLevel == 0) { hold = hold + 4; }
  aiHold[1] = hold;
}

// ---------------------------------------------------------------- combat

fn addMeter(i: u8, amt: u8): void {
  let m: u8 = fmeter[i];
  m = m + amt;
  if (m > 100) { m = 100; }
  fmeter[i] = m;
}

fn moveX(i: u8, dir: u8, amt: u8): void {
  let x: u8 = fx[i];
  if (dir == 1) {
    x = x + amt;
    if (x > 248) { x = 248; }
  } else {
    if (x > amt) { x = x - amt; } else { x = 0; }
  }
  fx[i] = x;
}

// Attacker i strikes from horizontal position ax. kind 0: high (crouching dodges it),
// kind 1: mid (jumping dodges it), kind 2: anywhere close to the attacker's own height.
// Returns 1 when it connects, blocked or not.
fn hit(i: u8, ax: u8, kind: u8, reach: u8, dmg: u8): u8 {
  let o: u8 = 1 - i;
  let ox: u8 = fx[o];
  let d: u8 = absDiff(ax, ox);
  if (d >= reach) { return 0; }
  let st: u8 = fst[o];
  if (st == 8) { return 0; }
  let oh: u8 = fh[o];
  let t: u8 = ffr[o];
  if (kind == 0) {
    if (t == 4) { return 0; }
  }
  if (kind == 2) {
    t = fh[i];
    t = absDiff(oh, t);
    if (t > 20) { return 0; }
  } else {
    if (oh > 18) { return 0; }
  }
  let pd: u8 = 0;
  if (ox > ax) { pd = 1; }
  if (st == 9) { st = 0; }
  t = fblk[o];
  if (t != 0 && st == 0) {
    fst[o] = 9;
    ftm[o] = 6;
    fjd[o] = 0;
    moveX(o, pd, 5);
    pd = 1 - pd;
    moveX(i, pd, 2);
    addMeter(o, 3);
    sfx(0x60, 0x81, 2);
    freeze = 2;
    drawSide(o);
    return 1;
  }
  t = fhp[o];
  if (dmg < t) { t = t - dmg; } else { t = 0; }
  fhp[o] = t;
  fst[o] = 6;
  ftm[o] = 13;
  ffr[o] = 0;
  fflash[o] = 4;
  pd = pd + 1;
  fjd[o] = pd;
  addMeter(i, 12);
  addMeter(o, 6);
  sfx(0x18, 0x81, 5);
  freeze = 4;
  shake = 2;
  if (t == 0) {
    fst[o] = 8;
    ftm[o] = 0;
    roundOver = 1;
    winner = i;
    freeze = 10;
    shake = 10;
  }
  drawSide(o);
  drawSide(i);
  return 1;
}

fn startSpecial(i: u8): void {
  let c: u8 = fchr[i];
  let m: u8 = fmeter[i];
  let d: u8 = spDmg[c];
  if (m >= 100) {
    d = d + d;
    fmeter[i] = 0;
    shake = 6;
    drawSide(i);
  }
  fdmg[i] = d;
  fst[i] = 7;
  ftm[i] = spLen[c];
  ffr[i] = spFrame[c];
  fhit[i] = 0;
  fjt[i] = 0;
  fcool[i] = 40;
  sfxSpecial();
}

// One routine drives all four specials from the tables: a projectile, a dash, a slam and a rising strike.
fn runSpecial(i: u8): void {
  let c: u8 = fchr[i];
  let tm: u8 = ftm[i];
  let ax: u8 = fx[i];
  let dir: u8 = 1;
  let t: u8 = fface[i];
  if (t == 1) { dir = 0; }
  t = spProj[c];
  if (t == 1) {
    if (tm == 20) {
      t = pjOn[i];
      if (t == 0) {
        pjOn[i] = 1;
        pjDir[i] = dir;
        t = 0;
        if (dir == 1) { t = ax + 8; } else { if (ax > 8) { t = ax - 8; } }
        pjX[i] = t;
      }
    }
    return;
  }
  t = spMoveLo[c];
  if (tm > t) {
    t = spMoveHi[c];
    if (tm < t) {
      t = spSpd[c];
      moveX(i, dir, t);
    }
  }
  t = spJump[c];
  if (t == 1) {
    t = fjt[i];
    if (t < 27) {
      t = t + 1;
      fjt[i] = t;
    }
    t = jumpTab[t];
    fh[i] = t;
  }
  t = fhit[i];
  if (t == 0) {
    t = spHitLo[c];
    if (tm > t) {
      t = spHitHi[c];
      if (tm < t) {
        let kind: u8 = spKind[c];
        let reach: u8 = spReach[c];
        let dg: u8 = fdmg[i];
        t = hit(i, ax, kind, reach, dg);
        if (t == 1) {
          fhit[i] = 1;
          shake = 6;
        }
      }
    }
  }
}

fn runProjectile(i: u8): void {
  let t: u8 = pjOn[i];
  if (t == 0) { return; }
  let x: u8 = pjX[i];
  t = pjDir[i];
  if (t == 1) {
    if (x < 243) { x = x + 5; } else { pjOn[i] = 0; }
  } else {
    if (x > 5) { x = x - 5; } else { pjOn[i] = 0; }
  }
  pjX[i] = x;
  t = pjOn[i];
  if (t == 1) {
    t = fdmg[i];
    t = hit(i, x, 1, 22, t);
    if (t == 1) { pjOn[i] = 0; }
    let o: u8 = 1 - i;
    t = pjOn[o];
    if (t == 1) {
      t = pjX[o];
      t = absDiff(x, t);
      if (t < 16) {
        pjOn[i] = 0;
        pjOn[o] = 0;
        sfx(0x60, 0x81, 2);
      }
    }
  }
}

fn updateFighter(i: u8): void {
  let o: u8 = 1 - i;
  let c: u8 = fchr[i];
  let st: u8 = fst[i];
  let tm: u8 = ftm[i];
  let m: u8 = inm[i];
  let ax: u8 = fx[i];
  let t: u8 = prev[i];
  let held: u8 = t & 48;
  let press: u8 = 0;
  t = m & 48;
  if (held == 0) { press = t; }
  prev[i] = m;
  if (st == 0) {
    t = fx[o];
    fface[i] = 1;
    if (t > ax) { fface[i] = 0; }
  }
  let fwd: u8 = 8;
  let back: u8 = 4;
  t = fface[i];
  if (t == 1) { fwd = 4; back = 8; }
  t = m & back;
  fblk[i] = t;
  t = fflash[i];
  if (t > 0) { fflash[i] = t - 1; }
  // Quarter-circle input memory: down, then forward, then punch within a short window.
  let q: u8 = fqc[i];
  t = fqct[i];
  if (t > 0) { fqct[i] = t - 1; } else { q = 0; }
  let fm: u8 = m & fwd;
  t = m & 2;
  if (t != 0) {
    if (fm == 0) { q = 1; fqct[i] = 18; }
  }
  if (q == 1) {
    if (fm != 0) { q = 2; fqct[i] = 14; }
  }
  fqc[i] = q;
  let sp: u8 = 0;
  if (press == 48) { sp = 1; }
  t = press & 16;
  if (t != 0) {
    if (q == 2) { sp = 1; }
  }
  t = fcool[i];
  if (t > 0) {
    fcool[i] = t - 1;
    sp = 0;
  }
  if (st == 8) {
    t = fsink[i];
    if (t < 10) { fsink[i] = t + 1; }
    ffr[i] = 4;
    return;
  }
  if (st == 7) {
    runSpecial(i);
    if (tm > 0) {
      ftm[i] = tm - 1;
    } else {
      fst[i] = 0;
      ffr[i] = 0;
      fh[i] = 0;
    }
    return;
  }
  if (st > 5) {
    t = fjd[i];
    if (t > 0 && tm > 7) {
      t = t - 1;
      moveX(i, t, 3);
    }
    if (tm > 0) { ftm[i] = tm - 1; } else { fst[i] = 0; ffr[i] = 0; }
    return;
  }
  let rc: u8 = reachK[c];
  let dg: u8 = dmgK[c];
  if (st == 5) {
    t = fjt[i];
    let jv: u8 = jumpFast[t];
    fh[i] = jv;
    jv = fjd[i];
    if (jv == 1) { moveX(i, 1, 3); }
    if (jv == 2) { moveX(i, 0, 3); }
    if (press != 0) {
      ffr[i] = 3;
      jv = hit(i, ax, 2, rc, dg);
    }
    if (t < 19) {
      fjt[i] = t + 1;
    } else {
      fst[i] = 0;
      ffr[i] = 0;
      fh[i] = 0;
    }
    return;
  }
  if (st > 1) {
    let kind: u8 = st - 2;
    t = hitAt[kind];
    if (kind == 0) {
      rc = reachP[c];
      dg = dmgP[c];
    }
    if (tm == t) {
      t = hit(i, ax, kind, rc, dg);
      if (t == 0) { sfx(0x3C, 0x81, 1); }
    }
    if (tm > 0) { ftm[i] = tm - 1; } else { fst[i] = 0; ffr[i] = 0; }
    return;
  }
  // Free to act: special, jump, punch, kick, crouch or walk.
  if (sp == 1) {
    startSpecial(i);
    return;
  }
  t = m & 1;
  if (t != 0) {
    fst[i] = 5;
    fjt[i] = 0;
    ffr[i] = 5;
    fjd[i] = 0;
    t = m & 8;
    if (t != 0) { fjd[i] = 1; }
    t = m & 4;
    if (t != 0) { fjd[i] = 2; }
    return;
  }
  t = press & 48;
  if (t != 0) {
    fst[i] = 2;
    ftm[i] = 10;
    if (t == 32) {
      fst[i] = 3;
      ftm[i] = 14;
    }
    ffr[i] = fst[i];
    return;
  }
  ffr[i] = 0;
  t = m & 2;
  if (t != 0) {
    ffr[i] = 4;
    return;
  }
  let spd: u8 = walkSpd[c];
  t = m & 8;
  if (t != 0) { moveX(i, 1, spd); }
  t = m & 4;
  if (t != 0) { moveX(i, 0, spd); }
  t = m & 12;
  if (t != 0) {
    t = tick & 8;
    if (t != 0) { ffr[i] = 1; }
  }
}

// Keep the fighters from standing inside each other.
fn separate(): void {
  let a: u8 = fx[0];
  let b: u8 = fx[1];
  let d: u8 = absDiff(a, b);
  if (d < 30) {
    if (a < b) {
      moveX(0, 0, 1);
      moveX(1, 1, 1);
    } else {
      moveX(0, 1, 1);
      moveX(1, 0, 1);
    }
  }
}

fn resetRound(): void {
  let a: u16 = 0xC000;
  for (let n: u8 = 0; n < 52; n++) {
    poke(a, 0);
    a = a + 1;
  }
  fx[0] = 50;
  fx[1] = 198;
  fface[1] = 1;
  fhp[0] = 100;
  fhp[1] = 100;
  prev[0] = 48;
  prev[1] = 48;
  secs = 99;
  subT = 0;
  freeze = 0;
  roundOver = 0;
  winner = 0;
}

fn playRound(): void {
  resetRound();
  drawStage(stage);
  drawHud();
  puts(10, 16, "ROUND  ", COLOR_YELLOW);
  poke(screen(10, 22), roundNo + 0x30);
  showFighters();
  pause(60);
  sfxSpecial();
  drawStage(stage);
  drawHud();
  while (roundOver == 0) {
    frame();
    scanPlayer(0, 0);
    if (twoP == 1) { scanPlayer(6, 1); } else { aiThink(); }
    if (freeze > 0) {
      freeze = freeze - 1;
    } else {
      updateFighter(0);
      updateFighter(1);
      runProjectile(0);
      runProjectile(1);
      separate();
    }
    showFighters();
    subT = subT + 1;
    if (subT == 50) {
      subT = 0;
      secs = secs - 1;
      drawTimer();
      if (secs == 0) {
        roundOver = 2;
        let a: u8 = fhp[0];
        let b: u8 = fhp[1];
        winner = 0;
        if (b > a) { winner = 1; }
        if (a == b) { winner = 2; }
      }
    }
    let t: u8 = tick & 7;
    if (t == 0) {
      drawSide(0);
      drawSide(1);
    }
  }
  puts(10, 15, "TIME OVER", COLOR_LIGHT_RED);
  if (roundOver == 1) {
    puts(10, 15, " K.O.     ", COLOR_LIGHT_RED);
    sfxKo();
    inm[0] = 0;
    inm[1] = 0;
    for (let n: u8 = 0; n < 50; n++) {
      frame();
      updateFighter(0);
      updateFighter(1);
      showFighters();
    }
  }
  pause(45);
  if (winner < 2) {
    let w: u8 = fwins[winner];
    fwins[winner] = w + 1;
    drawHud();
  }
}

// Returns the index of the player who took two rounds.
fn playMatch(): u8 {
  fwins[0] = 0;
  fwins[1] = 0;
  fmeter[0] = 0;
  fmeter[1] = 0;
  roundNo = 1;
  let c0: u8 = fchr[0];
  let c1: u8 = fchr[1];
  fcolor[0] = outfitCol[c0];
  fcolor[1] = outfitCol[c1];
  if (c0 == c1) { fcolor[1] = altCol[c1]; }
  setupSprites();
  let result: u8 = 2;
  while (result == 2) {
    playRound();
    if (fwins[0] == 2) { result = 0; }
    if (fwins[1] == 2) { result = 1; }
    roundNo = roundNo + 1;
    if (roundNo > 3) { roundNo = 3; }
  }
  VIC2.spriteEnable = 0;
  return result;
}

// ---------------------------------------------------------------- menus

fn drawCards(cur: u8): void {
  let col: u8 = 2;
  for (let c: u8 = 0; c < 4; c++) {
    let hue: u8 = COLOR_DARK_GREY;
    if (c == cur) { hue = COLOR_YELLOW; }
    showName(c, 10, col, hue);
    col = col + 9;
  }
  showSpecialName(cur, 13, 14, COLOR_CYAN);
}

// Each player picks in turn with their own left, right and punch keys.
fn pickFighter(w: u8): void {
  let kb: u8 = 2;
  if (w == 1) { kb = 8; }
  let cl: u8 = keyCol[kb];
  let ml: u8 = keyMask[kb];
  kb = kb + 1;
  let cr: u8 = keyCol[kb];
  let mr: u8 = keyMask[kb];
  kb = kb + 1;
  let cp: u8 = keyCol[kb];
  let mp: u8 = keyMask[kb];
  let s: u8 = w;
  let held: u8 = 12;
  let done: u8 = 0;
  clrscr();
  puts(1, 12, "CHOOSE YOUR FIGHTER", COLOR_WHITE);
  puts(4, 15, "PLAYER  ", COLOR_LIGHT_GREY);
  poke(screen(4, 22), w + 0x31);
  if (w == 0) {
    puts(18, 5, "A D = MOVE     F = PICK FIGHTER", COLOR_YELLOW);
  } else {
    puts(18, 5, "J L = MOVE     O = PICK FIGHTER", COLOR_CYAN);
  }
  drawCards(s);
  while (done == 0) {
    frame();
    if (held > 0) {
      held = held - 1;
    } else {
      if (keyDown(cl, ml) == 1) {
        if (s > 0) { s = s - 1; }
        held = 8;
        drawCards(s);
      }
      if (keyDown(cr, mr) == 1) {
        if (s < 3) { s = s + 1; }
        held = 8;
        drawCards(s);
      }
      if (keyDown(cp, mp) == 1) { done = 1; }
    }
  }
  fchr[w] = s;
  waitKeys();
}

fn titleScreen(): void {
  VIC2.spriteEnable = 0;
  VIC2.borderColor = COLOR_BLACK;
  clrscr();
  puts(5, 13, "STREET FIGHTER", COLOR_WHITE);
  puts(8, 12, "PRESS 1 OR 2", COLOR_YELLOW);
  puts(10, 12, "1  ONE PLAYER", COLOR_WHITE);
  puts(12, 12, "2  TWO PLAYERS", COLOR_WHITE);
  puts(16, 3, "P1  W A S D  F PUNCH  G KICK", COLOR_LIGHT_GREY);
  puts(17, 3, "P2  I J K L  O PUNCH  P KICK", COLOR_LIGHT_GREY);
  puts(19, 3, "HOLD BACK = BLOCK", COLOR_CYAN);
  puts(20, 3, "DOWN FWD PUNCH = SPECIAL", COLOR_CYAN);
  let choice: u8 = 0;
  while (choice == 0) {
    frame();
    if (keyDown(0x7F, 0x01) == 1) { choice = 1; }
    if (keyDown(0x7F, 0x08) == 1) { choice = 2; }
  }
  twoP = choice - 1;
  waitKeys();
}

program @ 0x0810 {
  VIC2.ctrl1 = 0x1B;
  VIC2.ctrl2 = 0x08;
  VIC2.memPointers = 0x15;
  VIC2.bgColor0 = COLOR_BLACK;
  VIC2.borderColor = COLOR_BLACK;
  CIA1.ddrA = 0xFF;
  CIA1.ddrB = 0;
  sidInit();
  loop {
    titleScreen();
    fchr[1] = 1;
    pickFighter(0);
    if (twoP == 1) { pickFighter(1); }
    let mine: u8 = fchr[0];
    let opp: u8 = 0;
    let beaten: u8 = 0;
    let w: u8 = 0;
    let more: u8 = 1;
    aiLevel = 0;
    while (more == 1) {
      if (twoP == 0) {
        if (opp == mine) { opp = opp + 1; }
        fchr[1] = opp;
      }
      stage = fchr[1];
      clrscr();
      puts(10, 15, "GET READY", COLOR_LIGHT_GREY);
      w = fchr[1];
      showName(w, 12, 17, COLOR_LIGHT_RED);
      pause(60);
      w = playMatch();
      clrscr();
      more = 0;
      if (twoP == 0 && w == 0) {
        beaten = beaten + 1;
        opp = opp + 1;
        aiLevel = beaten;
        if (aiLevel > 2) { aiLevel = 2; }
        if (beaten < 3) { more = 1; }
      }
    }
    if (twoP == 1) {
      puts(10, 14, "PLAYER   WINS", COLOR_YELLOW);
      poke(screen(10, 21), w + 0x31);
    } else {
      if (beaten == 3) {
        VIC2.borderColor = COLOR_YELLOW;
        puts(10, 15, "CHAMPION!", COLOR_YELLOW);
      } else {
        VIC2.borderColor = COLOR_RED;
        puts(10, 15, "GAME OVER", COLOR_LIGHT_RED);
      }
    }
    pause(200);
    VIC2.borderColor = COLOR_BLACK;
  }
}
