// Flappy Bird: press SPACE to flap, fly through the gaps. Click the screen first for keyboard focus.
// The bird is sprite 0. The pipes are columns of solid-block characters that step left across the
// screen, and the VIC-II tells us when the bird touches one (sprite-to-background collision).
const SHAPE: u16 = 0x2000;   // the bird's sprite data. Not $1000..$1FFF: the VIC-II sees the character ROM there.

data @addr(SHAPE) {
  bird: [u8; 63] = [
    0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
    0x01, 0xFC, 0x00,
    0x07, 0xFF, 0x00,
    0x0F, 0xFF, 0x80,
    0x1F, 0xFC, 0xC0,
    0x3F, 0xFC, 0xE0,
    0x3F, 0xFF, 0xFF,
    0x3F, 0xFF, 0xFF,
    0x79, 0xFF, 0xFF,
    0x3C, 0x3F, 0xFF,
    0x3F, 0xFF, 0xE0,
    0x3F, 0xFF, 0xE0,
    0x1F, 0xFF, 0xC0,
    0x0F, 0xFF, 0x80,
    0x07, 0xFF, 0x00,
    0x01, 0xFC, 0x00,
    0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
    0x00, 0x00, 0x00,
  ];
}

let @zp y: u8 = 100;          // the bird's height (sprite Y)
let @zp rise: u8 = 0;         // frames of climbing left after a flap
let @zp speed: u8 = 1;        // fall speed, grows while falling
let @zp ticks: u8 = 0;        // counts frames to speed the fall up
let @zp held: u8 = 0;         // SPACE was down on the previous frame
let @zp moveTick: u8 = 0;     // frames since the pipes last stepped
let @zp qa: u8 = 43;          // pipe A: leftmost column + 2 (43 = just off the right edge)
let @zp ga: u8 = 6;           // pipe A: first row of its gap
let @zp qb: u8 = 65;          // pipe B, half a screen behind
let @zp gb: u8 = 9;
let @zp tens: u8 = 0;
let @zp ones: u8 = 0;
let @zp rng: u8 = 77;
let @zp alive: u8 = 0;
let @zp dead: u8 = 0;         // the VIC-II collision register, read once per frame
let @zp title: u8 = 1;        // 1 until the first game starts: only then show the title

// Wait for one video frame.
fn frame(): void {
  while (VIC2.rasterLine != 200) {}
  while (VIC2.rasterLine == 200) {}
}

// 1 while SPACE is held: the keyboard matrix has SPACE on row 7 (PA7), column 4 (PB4).
fn space(): u8 {
  CIA1.portA = 0x7F;
  if ((CIA1.portB & 0x10) == 0) { return 1; }
  return 0;
}

// Writes `ch` down screen column `col`, rows 1..21 (row 0 is the score), leaving an 8-row hole
// that starts at `gap`. `cell` walks down the column: one row below is 40 cells further on.
fn column(col: u8, gap: u8, ch: u8): void {
  let cell: u16 = screen(1, col);
  let hole: u8 = gap + 8;
  for (let row: u8 = 1; row < 22; row++) {
    if (row < gap) {
      poke(cell, ch);
    } else if (row >= hole) {
      poke(cell, ch);
    }
    cell += 40;
  }
}

// Moves a pipe one column left: draw its new left column, erase the column it just left.
fn movePipe(q: u8, gap: u8): u8 {
  let n: u8 = q - 1;
  if (n >= 2) {
    if (n < 42) { column(n - 2, gap, 0xA0); }
  }
  if (n < 40) { column(n, gap, 0x20); }
  return n;
}

// A gap row from 3 to 10, stirred by where the bird is.
fn nextGap(): u8 {
  let g: u8 = y + rng;
  rng = rng + g;
  rng = rng + 11;
  g = g & 7;
  return g + 3;
}

fn addScore(): void {
  ones = ones + 1;
  if (ones == 10) {
    ones = 0;
    tens = tens + 1;
    if (tens == 10) { tens = 0; }
  }
  poke(screen(0, 38), tens + 0x30);
  poke(screen(0, 39), ones + 0x30);
}

// Waits until SPACE has been released and pressed again. The random seed keeps stirring meanwhile,
// so every game gets different gaps.
fn waitForSpace(): void {
  while (space() == 1) { frame(); }
  while (space() == 0) {
    frame();
    rng = rng + 1;
  }
}

// One-time hardware setup: video mode, keyboard, colours and the bird sprite.
fn setup(): void {
  VIC2.ctrl1 = 0x1B;          // screen on, 25 rows, text mode
  VIC2.memPointers = 0x15;    // screen RAM at $0400
  poke(0x3FFF, 0);            // the VIC-II draws this byte in the border; non-zero would count as a hit
  CIA1.ddrA = 0xFF;           // keyboard: columns out, rows in
  CIA1.ddrB = 0x00;
  VIC2.borderColor = COLOR_BLACK;
  VIC2.bgColor0 = COLOR_LIGHT_BLUE;
  poke(SPRITE_PTRS, spritePtr(SHAPE));
  VIC2.sprite0color = COLOR_YELLOW;
  VIC2.sprite0x = 80;
  VIC2.spriteEnable = 1;
}

// Clears the screen, makes all colour RAM green (pipes only need the character) and lays the ground.
fn drawField(): void {
  clrscr();
  for (let r: u8 = 0; r < 25; r++) {
    for (let c: u8 = 0; c < 40; c++) { poke(color(r, c), COLOR_GREEN); }
  }
  for (let r: u8 = 22; r < 25; r++) {      // the ground: rows 22..24
    for (let c: u8 = 0; c < 40; c++) {
      poke(screen(r, c), 0xA0);
      poke(color(r, c), COLOR_BROWN);
    }
  }
}

// Puts the bird and both pipes back at their starting positions and zeroes the score.
fn resetGame(): void {
  y = 100;
  rise = 0;
  speed = 1;
  ticks = 0;
  moveTick = 0;
  qa = 43;
  qb = 65;
  ga = 6;
  gb = 9;
  tens = 0;
  ones = 0;
  VIC2.sprite0y = y;
  puts(0, 31, "SCORE", COLOR_WHITE);
  puts(0, 38, "00", COLOR_WHITE);
}

// Shown once, before the first game.
fn showTitle(): void {
  puts(7, 14, "FLAPPY BIRD", COLOR_WHITE);
  puts(11, 14, "PRESS SPACE", COLOR_WHITE);
  waitForSpace();
  puts(7, 14, "           ", COLOR_WHITE);
  puts(11, 14, "           ", COLOR_WHITE);
}

// A fresh SPACE press (not a held key) starts a flap.
fn readFlap(): void {
  if (space() == 1) {
    if (held == 0) {
      rise = 8;
      speed = 1;
      ticks = 0;
    }
    held = 1;
  } else {
    held = 0;
  }
}

// Climb while `rise` lasts, otherwise fall a little faster every 6 frames.
fn moveBird(): void {
  if (rise > 0) {
    rise = rise - 1;
    if (y < 54) { y = 50; } else { y = y - 3; }
  } else {
    ticks = ticks + 1;
    if (ticks == 6) {
      ticks = 0;
      if (speed < 4) { speed = speed + 1; }
    }
    y = y + speed;
  }
  VIC2.sprite0y = y;
}

// Steps both pipes left, recycles one that left the screen, scores one that passed the bird.
fn movePipes(): void {
  if (qa == 0) { qa = 43; ga = nextGap(); }
  if (qb == 0) { qb = 43; gb = nextGap(); }
  qa = movePipe(qa, ga);
  qb = movePipe(qb, gb);
  if (qa == 7) { addScore(); }
  if (qb == 7) { addScore(); }
}

// Plays one game and returns when the bird hits a pipe or the ground.
fn play(): void {
  held = 1;
  rise = 8;
  dead = VIC2.spBgCol;      // reading clears it
  alive = 1;
  while (alive == 1) {
    frame();
    readFlap();
    moveBird();

    moveTick = moveTick + 1;
    if (moveTick == 5) {
      moveTick = 0;
      movePipes();
    }

    dead = VIC2.spBgCol;
    if ((dead & 1) != 0) { alive = 0; }
    if (y > 204) { alive = 0; }
  }
}

// Message, a short pause so a flap in progress can't skip it, then wait for SPACE.
fn gameOver(): void {
  puts(9, 15, "GAME OVER", COLOR_WHITE);
  puts(11, 13, "SPACE TO RETRY", COLOR_WHITE);
  ticks = 0;
  while (ticks < 40) {
    frame();
    ticks = ticks + 1;
  }
  waitForSpace();
}

program @ 0x0810 {
  setup();
  loop {
    drawField();
    resetGame();
    if (title == 1) {
      showTitle();
      title = 0;
    }
    play();
    gameOver();
  }
}
