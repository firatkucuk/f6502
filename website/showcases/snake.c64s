// SNAKE: W A S D or the arrow keys steer. Eat the red blocks to grow. SPACE starts and retries.
// Reach length 100 to win. The snake speeds up as it grows. Character mode, no sprites,
// no shifts or multiplication. The body is a circular buffer of row/column pairs.

let @addr(0x3000) bodyR: [u8; 128];
let @addr(0x3080) bodyC: [u8; 128];

let @zp dir: u8 = 1;
let @zp want: u8 = 1;
let @zp head: u8 = 2;
let @zp tail: u8 = 0;
let @zp length: u8 = 3;
let @zp fr: u8 = 12;
let @zp fc: u8 = 30;
let @zp rnd: u8 = 77;
let @zp rnd2: u8 = 151;
let @zp spd: u8 = 9;
let @zp ticker: u8 = 0;
let @zp alive: u8 = 1;
let @zp eaten: u8 = 0;
let @zp hundreds: u8 = 0;
let @zp tens: u8 = 0;
let @zp ones: u8 = 0;
let @zp tick: u8 = 0;

fn frame(): void {
  while (VIC2.rasterLine != 250) {}
  while (VIC2.rasterLine == 250) {}
}

fn space(): u8 {
  CIA1.portA = 0x7F;
  if ((CIA1.portB & 0x10) == 0) { return 1; }
  return 0;
}

fn upKey(): u8 {
  CIA1.portA = 0xFD;
  if ((CIA1.portB & 0x02) == 0) { return 1; }
  CIA1.portA = 0xFE;
  if ((CIA1.portB & 0x80) == 0) {
    CIA1.portA = 0xFD;
    if ((CIA1.portB & 0x80) == 0) { return 1; }
  }
  return 0;
}

fn downKey(): u8 {
  CIA1.portA = 0xFD;
  if ((CIA1.portB & 0x20) == 0) { return 1; }
  CIA1.portA = 0xFE;
  if ((CIA1.portB & 0x80) == 0) {
    CIA1.portA = 0xFD;
    if ((CIA1.portB & 0x80) != 0) { return 1; }
  }
  return 0;
}

fn leftKey(): u8 {
  CIA1.portA = 0xFD;
  if ((CIA1.portB & 0x04) == 0) { return 1; }
  CIA1.portA = 0xFE;
  if ((CIA1.portB & 0x04) == 0) {
    CIA1.portA = 0xFD;
    if ((CIA1.portB & 0x80) == 0) { return 1; }
  }
  return 0;
}

fn rightKey(): u8 {
  CIA1.portA = 0xFB;
  if ((CIA1.portB & 0x04) == 0) { return 1; }
  CIA1.portA = 0xFE;
  if ((CIA1.portB & 0x04) == 0) {
    CIA1.portA = 0xFD;
    if ((CIA1.portB & 0x80) != 0) { return 1; }
  }
  return 0;
}

fn waitForSpace(): void {
  while (space() == 1) { frame(); }
  while (space() == 0) { frame(); }
}

fn plot(row: u8, col: u8, hue: u8): void {
  poke(screen(row, col), 0xA0);
  poke(color(row, col), hue);
}

fn addScore(): void {
  ones = ones + 1;
  if (ones == 10) {
    ones = 0;
    tens = tens + 1;
    if (tens == 10) {
      tens = 0;
      hundreds = hundreds + 1;
      if (hundreds == 10) { hundreds = 0; }
    }
  }
  poke(screen(0, 36), hundreds + 0x30);
  poke(screen(0, 37), tens + 0x30);
  poke(screen(0, 38), ones + 0x30);
}

// Pick a random empty cell for the food and draw it.
fn placeFood(): void {
  let ok: u8 = 0;
  while (ok == 0) {
    rnd = rnd + tick;
    rnd = rnd + VIC2.rasterLine;
    rnd2 = rnd2 + rnd;
    rnd2 = rnd2 + VIC2.rasterLine;
    let t: u8 = rnd;
    while (t >= 22) { t = t - 22; }
    fr = t + 2;
    let u: u8 = rnd2;
    while (u >= 38) { u = u - 38; }
    fc = u + 1;
    let taken: u8 = 0;
    let i: u8 = 0;
    while (i < length) {
      let idx: u8 = tail + i;
      idx = idx & 127;
      let br: u8 = bodyR[idx];
      if (br == fr) {
        let bc: u8 = bodyC[idx];
        if (bc == fc) { taken = 1; }
      }
      i = i + 1;
    }
    if (taken == 0) { ok = 1; }
  }
  plot(fr, fc, COLOR_RED);
}

fn drawField(): void {
  VIC2.spriteEnable = 0;
  clrscr();
  for (let col: u8 = 0; col < 40; col++) {
    plot(1, col, COLOR_DARK_GREY);
    plot(24, col, COLOR_DARK_GREY);
  }
  for (let row: u8 = 1; row < 25; row++) {
    plot(row, 0, COLOR_DARK_GREY);
    plot(row, 39, COLOR_DARK_GREY);
  }
  puts(0, 1, "SNAKE", COLOR_LIGHT_GREEN);
  puts(0, 9, "WASD OR ARROWS", COLOR_LIGHT_GREY);
  puts(0, 29, "SCORE 000", COLOR_WHITE);
}

fn newGame(): void {
  dir = 1;
  want = 1;
  head = 2;
  tail = 0;
  length = 3;
  spd = 9;
  ticker = 0;
  alive = 1;
  eaten = 0;
  hundreds = 0;
  tens = 0;
  ones = 0;
  bodyR[0] = 12;
  bodyC[0] = 18;
  bodyR[1] = 12;
  bodyC[1] = 19;
  bodyR[2] = 12;
  bodyC[2] = 20;
  drawField();
  plot(12, 18, COLOR_GREEN);
  plot(12, 19, COLOR_GREEN);
  plot(12, 20, COLOR_LIGHT_GREEN);
  placeFood();
}

fn readKeys(): void {
  if (upKey() == 1) {
    want = 0;
  } else if (rightKey() == 1) {
    want = 1;
  } else if (downKey() == 1) {
    want = 2;
  } else if (leftKey() == 1) {
    want = 3;
  }
}

fn step(): void {
  // A reversal straight into the neck is ignored.
  let opp: u8 = (dir + 2) & 3;
  if (want != opp) { dir = want; }
  let hr: u8 = bodyR[head];
  let hc: u8 = bodyC[head];
  let nr: u8 = hr;
  let nc: u8 = hc;
  if (dir == 0) { nr = hr - 1; }
  if (dir == 1) { nc = hc + 1; }
  if (dir == 2) { nr = hr + 1; }
  if (dir == 3) { nc = hc - 1; }
  if (nr < 2) { alive = 0; }
  if (nr > 23) { alive = 0; }
  if (nc < 1) { alive = 0; }
  if (nc > 38) { alive = 0; }
  if (alive == 0) { return; }
  let eat: u8 = 0;
  if (nr == fr) {
    if (nc == fc) { eat = 1; }
  }
  // Without eating, the tail cell frees up this turn, so skip it in the check.
  let i: u8 = 0;
  if (eat == 0) { i = 1; }
  while (i < length) {
    let idx: u8 = tail + i;
    idx = idx & 127;
    let br: u8 = bodyR[idx];
    if (br == nr) {
      let bc: u8 = bodyC[idx];
      if (bc == nc) { alive = 0; }
    }
    i = i + 1;
  }
  if (alive == 0) { return; }
  plot(hr, hc, COLOR_GREEN);
  head = (head + 1) & 127;
  bodyR[head] = nr;
  bodyC[head] = nc;
  plot(nr, nc, COLOR_LIGHT_GREEN);
  if (eat == 1) {
    length = length + 1;
    addScore();
    eaten = eaten + 1;
    if (eaten == 4) {
      eaten = 0;
      if (spd > 3) { spd = spd - 1; }
    }
    if (length < 100) { placeFood(); }
  } else {
    let tr: u8 = bodyR[tail];
    let tc: u8 = bodyC[tail];
    poke(screen(tr, tc), 0x20);
    tail = (tail + 1) & 127;
  }
}

fn play(): void {
  while (alive == 1) {
    frame();
    tick = tick + 1;
    readKeys();
    ticker = ticker + 1;
    if (ticker >= spd) {
      ticker = 0;
      step();
    }
    if (length >= 100) { return; }
  }
}

program @ 0x0810 {
  VIC2.ctrl1 = 0x1B;
  VIC2.ctrl2 = 0x08;
  VIC2.memPointers = 0x15;
  VIC2.bgColor0 = COLOR_BLACK;
  VIC2.borderColor = COLOR_BLACK;
  CIA1.ddrA = 0xFF;
  CIA1.ddrB = 0;
  newGame();
  puts(8, 16, "SNAKE", COLOR_LIGHT_GREEN);
  puts(11, 8, "EAT THE RED BLOCKS TO GROW", COLOR_YELLOW);
  puts(13, 6, "DONT HIT THE WALLS OR YOURSELF", COLOR_LIGHT_GREY);
  puts(15, 9, "REACH LENGTH 100 TO WIN", COLOR_CYAN);
  puts(18, 14, "PRESS SPACE", COLOR_WHITE);
  waitForSpace();
  loop {
    newGame();
    play();
    if (length >= 100) {
      VIC2.borderColor = COLOR_GREEN;
      puts(10, 15, "YOU WIN", COLOR_YELLOW);
    } else {
      VIC2.borderColor = COLOR_RED;
      puts(10, 15, "GAME OVER", COLOR_YELLOW);
    }
    puts(12, 11, "SPACE TO PLAY AGAIN", COLOR_WHITE);
    waitForSpace();
    VIC2.borderColor = COLOR_BLACK;
  }
}
