{
  "name": "f6502",
  "version": "0.0.0",
  "description": "Browser-based 6502 / Commodore 64 emulator in TypeScript",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/core",
    "test:conformance": "vitest run test/conformance",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "fetch-test-data": "node scripts/fetch-test-data.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
